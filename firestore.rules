rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated (e.g. Gmail login)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to retrieve user profile data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Admin has full CRUD privileges
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.email == 'admin@saltandlight.in'
      );
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
    
    // Transactions collection: Users can view, Admin alone can CRUD
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Audit logs collection
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if false;
    }
    
    // Settings collection
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
